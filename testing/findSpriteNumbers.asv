clc
clear
close all

blank_sprite = 1;
currentSprite = 1;

game_scene = simpleGameEngine('retro_pack.png',16,16,5,[225,225,225]);

world = ones(9,9);

background = world;
foreground = blank_sprite * ones(size(background));

drawScene(game_scene, background, foreground);

game = true;

while game 
    key = getKeyboardInput(game_scene);
    switch key
        case 'uparrow'
            currentSprite = currentSprite + 1;
        case 'downarrow'
            currentSprite = currentSprite - 1;
        case 'w'
            currentSprite = currentSprite + 10;
        case 's'
            currentSprite = currentSprite - 10;
        otherwise
            disp("wrong key")
    end
    foreground(5,5) = currentSprite;
    drawScene(game_scene, background, foreground);
    disp(currentSprite);
end