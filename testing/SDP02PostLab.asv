spr_5 = 953;
spr_6 = 954;
spr_7 = 955;
spr_8 = 956;
spr_9 = 957;
spr_colon = 958;
spr_period = 959;
spr_percent = 960;
spr_A = 980;
spr_B = 981;
spr_C = 982;
spr_D = 983;
spr_E = 984;
spr_F = 985;
spr_G = 986;
spr_H = 987;
spr_I = 988;
