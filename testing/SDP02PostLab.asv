clc
clear
close all

% all initial passing in of sprites needed for this part
spr_blank = 1;
spr_player = 26;
spr_goal = 658;
spr_Apple = 944;
TL_Wall = 625;
TM_Wall = 626;
TR_Wall = 627;
LM_Wall = 657;
MM_Wall = 658;
RM_Wall = 659;
BL_Wall = 689;
BM_Wall = 690;
BR_Wall = 691;
spr_0 = 948;
spr_1 = 949;
