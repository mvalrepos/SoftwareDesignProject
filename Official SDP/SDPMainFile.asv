    %             case 'a'
    %                 new_player_col = new_player_col - 1;
    %             case 's'
    %                 new_player_row = new_player_row + 1;
    %             case 'd'
    %                 new_player_col = new_player_col + 1;
    %             case 'e'
    %                 if (new_player_col == goal_col && new_player_row == goal_row)
    %                     foreground2(:,:) = spr_A;
    %                     drawScene(game_scene, background1, foreground2);
    %                     pause(0.5);
    %                     foreground2(:,:) = spr_B;
    %                     drawScene(game_scene, background1, foreground2);
    %                     pause(0.45);
    %                     foreground2(:,:) = spr_C;
    %                     drawScene(game_scene, background1, foreground2);
    %                     pause(0.35);
    %                     scene1 = false;
