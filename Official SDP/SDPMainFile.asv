    %                 end
    %             case 'escape'
    %                 close all
    %                 game = false;
    %                 return;
    %             otherwise
    %                 disp("err wrong key")
    %         end
    %         foreground2(new_player_row,new_player_col) = spr_player;
    %         if(old_row ~= new_player_row || old_col ~= new_player_col)
    %             foreground2(old_row,old_col) = spr_blank;
    %         end
    %         drawScene(game_scene, background2, foreground2);
